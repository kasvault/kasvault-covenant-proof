pragma silverscript ^0.1.0;

// KasVault Buyback-Vault v10 (MAINNET) — v9 + ROLLOVER-SIG-Fix.
// AUDIT-FIX (04.10.2026, externes Gemini-Audit, verifiziert): Der v9-rollover war
// PERMISSIONLESS (nur CLTV). Jeder konnte 1x/Tag eine Tx bauen, die das
// Fee-Fenster (val-2M bis val-20M Sompi) maximal ausreizt — Griefing-Vektor:
// bis 0,18 KAS/Tag Vault-Kapital an Miner verbrennen. Fix: rollover verlangt
// jetzt die AGENT-Signatur (gleiche Trust-Domaene wie buy; dayLimit bleibt die
// harte Grenze, Owner-Drain die Notbremse). Alle anderen Entries unverändert
// zu v9 (Emergency-Recovery inklusive). Tx-Form Buy: IN0 Curve, IN1 Ledger,
// IN2 VAULT, IN3+ Funding.
contract VaultV10(int initKas, int initTok, int initSpentToday, temporal initRolloverAt,
                 int initBuyCount, int initMinTokens, int initDayLimit, int initRecoverPending) {
    int kas = initKas;
    int tok = initTok;
    int spentToday = initSpentToday;
    temporal rolloverAt = initRolloverAt;
    int buyCount = initBuyCount;
    int minTokens = initMinTokens;
    int dayLimit = initDayLimit;
    int recoverPending = initRecoverPending;

    entry buy(sig s, int kasIn, int tokOut) {
        pubkey agent = pubkey(0x63c15a20b01aa9c9c095c20b7144fc6d430004bc3ca4d20b8b387ba52f6676c6);
        require(checkSig(s, agent));
        require(recoverPending == 0);
        require(kasIn > 0);
        require(kasIn <= kas);
        require(spentToday + kasIn <= dayLimit);
        require(tokOut >= kasIn * minTokens / 1000000);
        require(tx.outputs[0].value == tx.inputs[0].value + kasIn);
        require(tx.outputs[6].value == tx.inputs[this.activeInputIndex].value - kasIn);
        validateOutputState(6, State { kas: kas - kasIn, tok: tok + tokOut,
            spentToday: spentToday + kasIn, rolloverAt: rolloverAt, buyCount: buyCount + 1,
            minTokens: minTokens, dayLimit: dayLimit, recoverPending: recoverPending });
    }

    entry rollover(sig s) {
        pubkey agent = pubkey(0x63c15a20b01aa9c9c095c20b7144fc6d430004bc3ca4d20b8b387ba52f6676c6);
        require(checkSig(s, agent));    // AUDIT-FIX: kein permissionless Fee-Window-Drain
        require(tx.time >= rolloverAt);
        validateOutputState(0, State { kas: kas, tok: tok,
            spentToday: 0, rolloverAt: rolloverAt + 24 hours, buyCount: buyCount,
            minTokens: minTokens, dayLimit: dayLimit, recoverPending: recoverPending });
        int val = tx.inputs[this.activeInputIndex].value;
        require(tx.outputs[0].value <= val - 2000000);
        require(tx.outputs[0].value >= val - 20000000);
    }

    entry reparam(sig s, int newMinTokens) {
        pubkey owner = pubkey(0x87e2808a632bd08c5fa9d8985528e651d8895bfcbec081982a1d8e154318c0ad);
        require(checkSig(s, owner));
        require(newMinTokens >= 100000);
        require(newMinTokens <= 1000000000000);
        validateOutputState(0, State { kas: kas, tok: tok,
            spentToday: spentToday, rolloverAt: rolloverAt, buyCount: buyCount,
            minTokens: newMinTokens, dayLimit: dayLimit, recoverPending: recoverPending });
        int val = tx.inputs[this.activeInputIndex].value;
        require(tx.outputs[0].value <= val - 2000000);
        require(tx.outputs[0].value >= val - 20000000);
    }

    entry topup(sig s, int amount) {
        pubkey owner = pubkey(0x87e2808a632bd08c5fa9d8985528e651d8895bfcbec081982a1d8e154318c0ad);
        require(checkSig(s, owner));
        require(amount > 0);
        int val = tx.inputs[this.activeInputIndex].value;
        require(tx.outputs[0].value == val + amount);
        validateOutputState(0, State { kas: kas + amount, tok: tok,
            spentToday: spentToday, rolloverAt: rolloverAt, buyCount: buyCount,
            minTokens: minTokens, dayLimit: dayLimit, recoverPending: recoverPending });
    }

    entry drain(sig s) {
        pubkey owner = pubkey(0x87e2808a632bd08c5fa9d8985528e651d8895bfcbec081982a1d8e154318c0ad);
        require(checkSig(s, owner));   // Covenant endet hier — normaler Owner-Exit
    }

    // ---- NEU: Emergency-Recovery -------------------------------------
    entry requestRecovery(sig s) {
        pubkey owner = pubkey(0x87e2808a632bd08c5fa9d8985528e651d8895bfcbec081982a1d8e154318c0ad);
        pubkey backup = pubkey(0xf910d8b9e3e6a6b1eb37341a26dff8eb7862ed5a8e833cd0f1056005a6f6ab72);
        require(checkSig(s, owner) || checkSig(s, backup));
        require(recoverPending == 0);
        validateOutputState(0, State { kas: kas, tok: tok,
            spentToday: spentToday, rolloverAt: rolloverAt, buyCount: buyCount,
            minTokens: minTokens, dayLimit: dayLimit, recoverPending: 1 });
        int val = tx.inputs[this.activeInputIndex].value;
        require(tx.outputs[0].value <= val - 2000000);
        require(tx.outputs[0].value >= val - 20000000);
    }

    entry cancelRecovery(sig s) {
        pubkey owner = pubkey(0x87e2808a632bd08c5fa9d8985528e651d8895bfcbec081982a1d8e154318c0ad);
        require(checkSig(s, owner));
        require(recoverPending == 1);
        validateOutputState(0, State { kas: kas, tok: tok,
            spentToday: spentToday, rolloverAt: rolloverAt, buyCount: buyCount,
            minTokens: minTokens, dayLimit: dayLimit, recoverPending: 0 });
        int val = tx.inputs[this.activeInputIndex].value;
        require(tx.outputs[0].value <= val - 2000000);
        require(tx.outputs[0].value >= val - 20000000);
    }

    entry executeRecovery(sig s) {
        pubkey backup = pubkey(0xf910d8b9e3e6a6b1eb37341a26dff8eb7862ed5a8e833cd0f1056005a6f6ab72);
        require(checkSig(s, backup));
        require(recoverPending == 1);
        require(this.ageDaa >= 172800);   // ~48 h ab Request-Confirm (DAA)
    }
}
